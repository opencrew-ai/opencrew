# Required for agent runs (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — auto-generated into .env on first boot if missing
# SESSION_SECRET=
# PORT=3001

# Optional — how deep agent→agent @mention chains may go (default 4).
# Rate limits (maxRunsPerHour per agent) remain the hard safety valve.
# OPENCREW_MAX_MENTION_DEPTH=4

# Optional — remote access on your own domain via a named Cloudflare tunnel.
# Create the tunnel in Cloudflare Zero Trust pointed at http://localhost:5173,
# then set both. Unset = "Enable remote access" uses a quick tunnel with a
# random trycloudflare.com URL instead.
# OPENCREW_TUNNEL_TOKEN=
# OPENCREW_TUNNEL_URL=https://hq.opencrew.run

# Optional — X (Twitter) posting via `pnpm tweet "text"` or agent skill.
# API path (preferred): get keys at https://developer.x.com → your app → Keys and Tokens
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
#
# Browser path (fallback — uses Playwright, no API keys needed):
# X_USERNAME=
# X_PASSWORD=
